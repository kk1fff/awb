{
  "name": "agent-world-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/main.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist/server/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts",
    "test:api": "vitest run tests/api.test.ts",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test",
    "tool": "tsx src/cli.ts",
    "demo:garden": "tsx scripts/garden.ts",
    "format:check": "prettier --check src scripts tests docs README.md agent-process-feedback.md *.json *.ts index.html public",
    "api": "tsx watch src/server/main.ts",
    "web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
